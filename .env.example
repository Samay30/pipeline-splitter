# ---- Entra ID app registration (same pattern as packages/invoicing) ----
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# ---- Where the pipeline workbooks live ----
# Option A (fastest, no lookups): the drive ID directly.
# DRIVE_ID=b!....

# Option B: site ID (from Graph) — drive resolved by DRIVE_NAME.
# SITE_ID=

# Option C: hostname + server-relative path — site and drive both resolved.
SITE_HOSTNAME=yourtenant.sharepoint.com
SITE_PATH=/sites/Eggers_GTM_Collission
DRIVE_NAME=Documents

# Folder inside the drive that holds the workbooks.
# For a Teams channel folder this is usually "<ChannelName>/<subfolder>",
# e.g. "General/eggers-pipeline" — verify in SharePoint's "Open in SharePoint" view.
PIPELINE_FOLDER_PATH=eggers-pipeline

# ---- Behavior ----
# Regex a file must match to be treated as a master workbook.
MASTER_PATTERN=_Pipeline_.*\.xlsx$
# Suffix appended to derived files (also used to exclude them from re-processing).
RECAP_SUFFIX=_RECAP
# How many most-recent weekly tabs the recap keeps.
WEEKS_TO_KEEP=10

# ---- Security ----
# Vercel sends this automatically to /api/cron when set in project env.
# Generate: openssl rand -hex 32
CRON_SECRET=
